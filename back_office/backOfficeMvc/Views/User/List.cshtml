@model backOfficeMvc.Models.ViewModels.UserListViewModel
@{
    ViewBag.Title = "List";
}

<h2>Liste des utilisateurs</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Login</th>
            <th scope="col">Mdp</th>
            <th scope="col">Nom</th>
            <th scope="col">Prenom</th>
            <th scope="col">Adresse</th>
            <th scope="col">Role</th>
            <th scope="col">Modifier</th>
            <th scope="col">Supprimer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td scope="row">@user.Id</td>
                <td>@user.Login</td>
                <td>@user.Mdp</td>
                <td>@user.Nom</td>
                <td>@user.Prenom</td>
                <td>@user.Adresse</td>
                <td>@user.Role</td>
                <td><a href="@user.Id/Edit">Modifier</a></td>
                <td><a href="@user.Id/Delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');">Supprimer</a></td>
            </tr>
        }
    </tbody>
</table>
<form action="Create">
    <button class="btn btn-secondary" type="submit">Créer un nouvel utilisateur</button>
</form>