
@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm("Edit", "User", FormMethod.Post))
{
    <form>
        <div>
            <label for="Login">Login</label>
            <input type="text" name="Login" value="@Model.Login" />
        </div>
        <div>
            <label for="Mdp">Mdp</label>
            <input type="text" name="Mdp" value="@Model.Mdp" />
        </div>
        <div>
            <label for="Nom">Nom</label>
            <input type="text" name="Nom" value="@Model.Nom" />
        </div>
        <div>
            <label for="Prenom">Prenom</label>
            <input type="text" name="Prenom" value="@Model.Prenom" />
        </div>
        <div>
            <label for="Adresse">Adresse</label>
            <input type="text" name="Adresse" value="@Model.Adresse" />
        </div>
        <div>
            <label for="Role">Role</label>
            <input type="text" name="Role" value="@Model.Role" />
        </div>

        <div>
            <button type="submit">Edit</button>
        </div>
    </form>
}