
@{
    ViewBag.Title = "List";
}

<h2>List</h2>

<table class="table-bordered">
    <thead>
        <tr>
            <th>Total</th>
            <th>Quantité d'articles</th>
            <th>Date de début</th>
            <th>Date de fin</th>
            <th>Article ID</th>
            <th>Client ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var commande in Model.Commandes)
        {
            <tr>
                <td>@commande.Prix_total €</td>
                <td>@commande.Qte_articles</td>
                <td>@commande.DateDebut</td>
                <td>@commande.DateFin</td>
                <td>@commande.Article_id</td>
                <td>@commande.Client_id</td>
                <td><a href="@commande.Id/Edit">Modifier</a></td>
                <td><a href="@commande.Id/Delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette commande ?');">Supprimer</a></td>
            </tr>
        }
    </tbody>
</table>
<form action="Create">
    <input type="submit" value="Créer une nouvelle commande"/>
</form>