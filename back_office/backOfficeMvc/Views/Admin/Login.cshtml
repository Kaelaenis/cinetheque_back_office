@model backOfficeMvc.Models.Admin
@{
    ViewBag.Title = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-auto">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4 text-secondary fw-semibold">Connexion</h2>
                    @using (Html.BeginForm("Login", "Admin", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label for="Login" class="form-label fw-medium">Login</label>
                            <input type="text" name="Login" id="Login" class="form-control" placeholder="Entrer le login" required />
                        </div>
                        <div class="mb-3">
                            <label for="Password" class="form-label fw-medium">Mot de passe</label>
                            <input type="password" name="Password" id="Password" class="form-control" placeholder="Entrer le mot de passe" required />
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-secondary btn-lg rounded-pill">
                                <i class="bi bi-check-circle me-2"></i> Se connecter
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
