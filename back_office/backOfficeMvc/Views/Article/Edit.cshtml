
@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using (Html.BeginForm("Edit", "Article", FormMethod.Post))
{
    <form>
        <input type="hidden" name="Id" value="@Model.Id" />
        <div>
            <label for="Nom">Nom:</label>
            <input type="text" id="Nom" name="Nom" value="@Model.Nom" required />
        </div>
        <div>
            <label for="Prix">Prix (€):</label>
            <input type="number" id="Prix" name="Prix" step="0.01" value="@Model.Prix" required />
        </div>
        <div>
            <label for="CategorieNom">Catégorie:</label>
            <select id="CategorieNom" name="CategorieNom" required>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
        <div>
            <label for="Description">Description:</label>
            <textarea id="Description" name="Description" required>@Model.Description</textarea>
        </div>
        <div>
            <label for="QteTotal">Quantité totale:</label>
            <input type="number" id="QteTotal" name="QteTotal" value="@Model.QteTotal" required />
        </div>
        <div>
            <label for="QteDispo">Quantité disponible:</label>
            <input type="number" id="QteDispo" name="QteDispo" value="@Model.QteDispo" required />
        </div>

        <button type="submit">Enregistrer</button>
    </form>
}
