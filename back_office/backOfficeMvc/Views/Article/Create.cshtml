
@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

@using (Html.BeginForm("Create", "Article", FormMethod.Post))
{
    <form>
        <div>
            <label for="Nom">Nom:</label>
            <input type="text" id="Nom" name="Nom" required />
        </div>
        <div>
            <label for="Prix">Prix (€):</label>
            <input type="number" id="Prix" name="Prix" step="0.01" required />
        </div>
        <div>
            <label for="CategorieNom">Catégorie:</label>
            <select id="CategorieNom" name="CategorieNom" required>
                @foreach (var cat in ViewBag.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
        <div>
            <label for="Description">Description:</label>
            <textarea id="Description" name="Description" required></textarea>
        </div>
        <div>
            <label for="QteTotal">Quantité totale:</label>
            <input type="number" id="QteTotal" name="QteTotal" required />
        </div>
        <div>
            <label for="QteDispo">Quantité disponible:</label>
            <input type="number" id="QteDispo" name="QteDispo" required />
        </div>

        <button type="submit">Enregistrer</button>
    </form>
}