@model backOfficeMvc.Models.ViewModels.ArticleListViewModel
<h2>Liste des articles</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Nom</th>
            <th scope="col">Prix</th>
            <th scope="col">Catégorie</th>
            <th scope="col">Description</th>
            <th scope="col">Quantité totale</th>
            <th scope="col">Quantité disponible</th>
            <th scope="col">Modifier</th>
            <th scope="col">Supprimer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var article in Model.Articles)
        {
            <tr>
                <td scope="row">@article.Id</td>
                <td>@article.Nom</td>
                <td>@article.Prix €</td>
                <td>@article.CategorieNom</td>
                <td class="text-truncate" style="max-width : 300px">@article.Description</td>
                <td>@article.QteTotal</td>
                <td>@article.QteDispo</td>
                <td><a href="@article.Id/Edit">Modifier</a></td>
                <td><a href="@article.Id/Delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?');">Supprimer</a></td>
            </tr>
        }
    </tbody>
</table>
<form action="Create">
    <button class="btn btn-secondary" type="submit">Créer un nouvel article</button>
</form>